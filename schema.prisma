generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ORGANISATION
// ============================================================================

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  companies Company[]
  projects  Project[]
  scopedAssignments UserAssignment[]
}

model Company {
  id         String   @id @default(cuid())
  name       String
  locationId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  location          Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  scopedAssignments UserAssignment[]

  @@index([locationId])
}

// Replaces ErrProject and the free-text projectName columns.
model Project {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  locationId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location          Location?                    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  documents         Document[]
  flowAssignments   DocumentWorkflowAssignment[]
  scopedAssignments UserAssignment[]
  counters          DocumentNumberCounter[]
  processInstances  ProcessInstance[]

  @@index([locationId, isActive])
}

// The four fixed kinds of user: Clerk, Engineer, Manager, Admin.
// Replaces the "type" half of the old UserRole enum. Never changes after account creation.
model UserType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  users                 User[]
  workflowStepApprovers DocumentWorkflowStepApprover[]
  approvalStepApprovers DocumentApprovalStepApprover[]
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  userTypeId            String
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sessionVersion        Int       @default(0)
  signatureFileSize     Int?
  signatureMimeType     String?
  signatureOriginalName String?
  signaturePath         String?
  signatureUpdatedAt    DateTime?

  userType                  UserType                       @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  assignments               UserAssignment[]
  delegationsGiven          ApprovalDelegation[]           @relation("DelegationsGiven")
  delegationsReceived       ApprovalDelegation[]           @relation("DelegationsReceived")
  delegationsCreated        ApprovalDelegation[]           @relation("DelegationsCreatedBy")
  approvalHistory           ApprovalHistory[]              @relation("ApprovalsPerformedBy")
  approvalsOnBehalfOf       ApprovalHistory[]              @relation("ApprovalsOnBehalfOf")
  auditLogsPerformed        AuditLog[]                     @relation("AuditLogsPerformedBy")
  deletionRequestsReviewed  DeletionRequest[]              @relation("DeletionRequestsReviewedBy")
  deletionRequestsApproved  DeletionRequest[]              @relation("DeletionRequestsApprovedBy")
  deletionRequestsRequested DeletionRequest[]              @relation("DeletionRequestsRequestedBy")
  createdDocuments          Document[]                     @relation("DocumentsCreatedBy")
  receivedDocuments         Document[]                     @relation("DocumentsReceivedBy")
  uploadedVersions          DocumentVersion[]              @relation("VersionsUploadedBy")
  approvalStepsActed        DocumentApprovalStep[]         @relation("ApprovalStepActedBy")
  workflowStepApprovals     DocumentWorkflowStepApprover[] @relation("WorkflowStepApprover")
  approvalStepApprovals     DocumentApprovalStepApprover[] @relation("ApprovalStepApprover")
  emailNotificationEvents   EmailNotificationEvent[]       @relation("EmailEventsForUser")
  notifications             Notification[]                 @relation("NotificationsForUser")
  otpChallenges             OtpChallenge[]
  trustedDevices            TrustedDevice[]
  passwordResetTokens       PasswordResetToken[]
  processInstancesStarted   ProcessInstance[]              @relation("ProcessInstancesStartedBy")
  processStepLinks          ProcessStepDocument[]          @relation("ProcessStepLinkedBy")

  @@index([userTypeId, isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// DOCUMENT CONFIGURATION
// ============================================================================

// Replaces enum DocumentType, enum ErrType, enum ErrFileKind and PurchaseOrder.
model DocumentType {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String   @unique
  description      String?
  namingPattern    String   @default("{TYPE}-{PROJECT}-{YYYY}-{SEQ:4}")
  supportsLineItems Boolean @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  subtypes          DocumentSubtype[]
  fieldDefinitions  FieldDefinition[]
  counters          DocumentNumberCounter[]
  documents         Document[]
  flowAssignments   DocumentWorkflowAssignment[]
  processSteps      ProcessStep[]
  scopedAssignments UserAssignment[]
}

// Replaces Document.documentSubtype, enum MrType, enum ComparisonType and the ERR type variants.
model DocumentSubtype {
  id             String   @id @default(cuid())
  documentTypeId String
  code           String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  documentType      DocumentType                 @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  fieldDefinitions  FieldDefinition[]
  documents         Document[]
  flowAssignments   DocumentWorkflowAssignment[]
  processSteps      ProcessStep[]
  scopedAssignments UserAssignment[]

  @@unique([documentTypeId, code])
  @@unique([documentTypeId, name])
}

model FieldDefinition {
  id                String        @id @default(cuid())
  documentTypeId    String
  documentSubtypeId String?
  fieldGroup        FieldGroup    @default(HEADER)
  fieldKey          String
  label             String
  dataType          FieldDataType
  isRequired        Boolean       @default(false)
  options           Json?
  sortOrder         Int           @default(0)
  isActive          Boolean       @default(true)

  documentType    DocumentType        @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype DocumentSubtype?    @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  values          DocumentFieldValue[]

  @@unique([documentTypeId, documentSubtypeId, fieldGroup, fieldKey])
  @@index([documentTypeId, documentSubtypeId, isActive])
}

// Running counter behind document numbers: one per type, project and year.
// projectId is nullable because a document may exist without a project.
model DocumentNumberCounter {
  id             String  @id @default(cuid())
  documentTypeId String
  projectId      String?
  periodYear     Int
  lastValue      Int     @default(0)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([documentTypeId, projectId, periodYear])
}

// ============================================================================
// ROLES, PERMISSIONS AND ACCESS
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  assignments UserAssignment[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// This user holds this role, limited to the scope columns that are set.
// An empty scope column means no restriction on that item.
// Replaces UserRoleAssignment and ErrUserAccess.
model UserAssignment {
  id                  String   @id @default(cuid())
  userId              String
  roleId              String
  companyId           String?
  projectId           String?
  locationId          String?
  documentTypeId      String?
  documentSubtypeId   String?
  processDefinitionId String?
  createdAt           DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  documentType      DocumentType?      @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype   DocumentSubtype?   @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  processDefinition ProcessDefinition? @relation(fields: [processDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId, projectId, locationId, documentTypeId, documentSubtypeId, processDefinitionId])
  @@index([userId])
  @@index([roleId])
  @@index([projectId])
}

// An admin hands one user's approval tasks to another user until the row is deleted.
model ApprovalDelegation {
  id              String   @id @default(cuid())
  delegatorUserId String
  delegateUserId  String
  createdById     String
  reason          String?
  createdAt       DateTime @default(now())

  delegator User @relation("DelegationsGiven", fields: [delegatorUserId], references: [id], onDelete: Cascade)
  delegate  User @relation("DelegationsReceived", fields: [delegateUserId], references: [id], onDelete: Cascade)
  createdBy User @relation("DelegationsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([delegatorUserId, delegateUserId])
  @@index([delegateUserId])
}

// ============================================================================
// APPROVAL FLOWS
// ============================================================================

// A named approval chain. Keeps the old model name; targeting moved to DocumentWorkflowAssignment.
model DocumentWorkflowTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       DocumentWorkflowStep[]
  assignments DocumentWorkflowAssignment[]
  documents   Document[]
}

// stepNumber 0 = uploader step; 1 to 10 = approval levels.
model DocumentWorkflowStep {
  id         String   @id @default(cuid())
  templateId String
  stepNumber Int
  name       String?
  createdAt  DateTime @default(now())

  template  DocumentWorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvers DocumentWorkflowStepApprover[]

  @@unique([templateId, stepNumber])
}

// Who may act on a level (any one entry is enough): a named user OR every user of a user type.
model DocumentWorkflowStepApprover {
  id           String       @id @default(cuid())
  stepId       String
  approverType ApproverType
  userTypeId   String?
  userId       String?

  step     DocumentWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userType UserType?            @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  user     User?                @relation("WorkflowStepApprover", fields: [userId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([userId])
  @@index([userTypeId])
}

// Decides which flow a document gets. Most specific row wins. Null templateId = auto-approve.
model DocumentWorkflowAssignment {
  id                String   @id @default(cuid())
  documentTypeId    String
  documentSubtypeId String?
  projectId         String?
  templateId        String?
  createdAt         DateTime @default(now())

  documentType    DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype DocumentSubtype?          @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        DocumentWorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([documentTypeId, documentSubtypeId, projectId])
  @@index([templateId])
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id                        String         @id @default(cuid())
  documentNumber            String         @unique
  submissionKey             String?        @unique
  title                     String
  description               String?
  status                    DocumentStatus @default(PENDING)
  currentVersion            Int            @default(1)
  revisionNumber            Int            @default(1)
  lockVersion               Int            @default(0)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  approvedAt                DateTime?
  createdById               String
  documentTypeId            String
  documentSubtypeId         String?
  projectId                 String?
  workflowTemplateId        String?
  currentWorkflowStep       Int?
  currentApproverAssignedAt DateTime?
  downloadedAt              DateTime?
  lastActiveStage           DocumentStatus?
  receivedAt                DateTime?
  receivedById              String?

  createdBy         User                      @relation("DocumentsCreatedBy", fields: [createdById], references: [id])
  receivedBy        User?                     @relation("DocumentsReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  documentType      DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  documentSubtype   DocumentSubtype?          @relation(fields: [documentSubtypeId], references: [id], onDelete: Restrict)
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workflowTemplate  DocumentWorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]
  approvals         ApprovalHistory[]
  approvalSteps     DocumentApprovalStep[]
  lineItems         DocumentLineItem[]
  fieldValues       DocumentFieldValue[]
  deletionRequests  DeletionRequest[]         @relation("DeletionRequests")
  processLinks      ProcessStepDocument[]

  @@index([createdById])
  @@index([workflowTemplateId])
  @@index([documentTypeId, documentSubtypeId])
  @@index([projectId, status])
  @@index([status, currentWorkflowStep])
  @@index([createdAt])
  @@index([receivedById])
}

model DocumentLineItem {
  id         String @id @default(cuid())
  documentId String
  lineNo     Int

  document    Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldValues DocumentFieldValue[]

  @@unique([documentId, lineNo])
}

model DocumentFieldValue {
  id                String    @id @default(cuid())
  documentId        String
  fieldDefinitionId String
  lineItemId        String?
  valueText         String?
  valueNumber       Decimal?
  valueDate         DateTime? @db.Date
  valueBoolean      Boolean?
  valueJson         Json?

  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition  @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  lineItem        DocumentLineItem? @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@unique([documentId, fieldDefinitionId, lineItemId])
  @@index([fieldDefinitionId])
}

// Uploaded file versions. Keeps the old model and column names.
model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  versionNumber  Int
  revisionNumber Int      @default(1)
  filePath       String
  storageFolder  String?
  originalName   String
  extension      String?
  mimeType       String
  fileSize       Int
  uploadedAt     DateTime @default(now())
  uploadedById   String

  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User              @relation("VersionsUploadedBy", fields: [uploadedById], references: [id])
  approvalEvents  ApprovalHistory[] @relation("ApprovalInputVersion")
  approvalOutputs ApprovalHistory[] @relation("ApprovalOutputVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

// ============================================================================
// PROCESSES
// ============================================================================

model ProcessDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  steps             ProcessStep[]
  instances         ProcessInstance[]
  scopedAssignments UserAssignment[]
}

model ProcessStep {
  id                  String  @id @default(cuid())
  processDefinitionId String
  stepNumber          Int
  name                String
  documentTypeId      String
  documentSubtypeId   String?

  processDefinition ProcessDefinition   @relation(fields: [processDefinitionId], references: [id], onDelete: Cascade)
  documentType      DocumentType        @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  documentSubtype   DocumentSubtype?    @relation(fields: [documentSubtypeId], references: [id], onDelete: Restrict)
  stepDocuments     ProcessStepDocument[]

  @@unique([processDefinitionId, stepNumber])
}

model ProcessInstance {
  id                  String        @id @default(cuid())
  processDefinitionId String
  projectId           String?
  reference           String?
  status              ProcessStatus @default(IN_PROGRESS)
  currentStepNumber   Int           @default(1)
  startedById         String
  startedAt           DateTime      @default(now())
  completedAt         DateTime?

  processDefinition ProcessDefinition     @relation(fields: [processDefinitionId], references: [id], onDelete: Restrict)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  startedBy         User                  @relation("ProcessInstancesStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  stepDocuments     ProcessStepDocument[]

  @@index([processDefinitionId, status])
  @@index([projectId])
}

// One current document fills a step of a running process; rejected ones stay as history.
// "Only one current document per step per run" is enforced by a partial unique index in the migration.
model ProcessStepDocument {
  id                String            @id @default(cuid())
  processInstanceId String
  processStepId     String
  documentId        String
  source            ProcessStepSource
  linkedById        String
  isCurrent         Boolean           @default(true)
  linkedAt          DateTime          @default(now())

  processInstance ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)
  processStep     ProcessStep     @relation(fields: [processStepId], references: [id], onDelete: Restrict)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  linkedBy        User            @relation("ProcessStepLinkedBy", fields: [linkedById], references: [id], onDelete: Restrict)

  @@unique([processInstanceId, processStepId, documentId])
  @@index([documentId])
}

// ============================================================================
// APPROVAL EXECUTION
// ============================================================================

// Copy of the flow's levels, made at upload. Later flow edits never change documents in progress.
model DocumentApprovalStep {
  id          String     @id @default(cuid())
  documentId  String
  levelNumber Int
  name        String?
  status      StepStatus @default(WAITING)
  actedById   String?
  actedAt     DateTime?
  comment     String?

  document  Document                       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actedBy   User?                          @relation("ApprovalStepActedBy", fields: [actedById], references: [id], onDelete: SetNull)
  approvers DocumentApprovalStepApprover[]

  @@unique([documentId, levelNumber])
}

model DocumentApprovalStepApprover {
  id           String       @id @default(cuid())
  stepId       String
  approverType ApproverType
  userTypeId   String?
  userId       String?

  step     DocumentApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userType UserType?            @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  user     User?                @relation("ApprovalStepApprover", fields: [userId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([userId])
  @@index([userTypeId])
}

// Permanent history (the PDF's document_activity_log). Replaces ApprovalHistory + ErrApprovalHistory.
model ApprovalHistory {
  id                  String             @id @default(cuid())
  documentId          String
  action              ApprovalActionType
  comments            String?
  performedAt         DateTime           @default(now())
  performedById       String
  versionId           String?
  outputVersionId     String?
  revisionNumber      Int                @default(1)
  levelNumber         Int?
  fromStatus          DocumentStatus?
  toStatus            DocumentStatus?
  revisionTargetLevel Int?
  onBehalfOfUserId    String?

  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  performedBy   User             @relation("ApprovalsPerformedBy", fields: [performedById], references: [id])
  onBehalfOf    User?            @relation("ApprovalsOnBehalfOf", fields: [onBehalfOfUserId], references: [id])
  version       DocumentVersion? @relation("ApprovalInputVersion", fields: [versionId], references: [id])
  outputVersion DocumentVersion? @relation("ApprovalOutputVersion", fields: [outputVersionId], references: [id])

  @@index([documentId, performedAt])
  @@index([performedById])
  @@index([versionId])
  @@index([outputVersionId])
}

// ============================================================================
// CARRIED OVER FROM THE CURRENT SYSTEM (not in the PDF)
// ============================================================================

// approver3Id is now approverId: the reviewer is anyone holding the deletion-review permission.
model DeletionRequest {
  id              String                @id @default(cuid())
  documentId      String
  requestedById   String
  approverId      String?
  status          DeletionRequestStatus @default(PENDING)
  reason          String?
  createdAt       DateTime              @default(now())
  reviewedAt      DateTime?
  adminReviewerId String?
  adminReviewer   User?                 @relation("DeletionRequestsReviewedBy", fields: [adminReviewerId], references: [id])
  approver        User?                 @relation("DeletionRequestsApprovedBy", fields: [approverId], references: [id])
  document        Document              @relation("DeletionRequests", fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy     User                  @relation("DeletionRequestsRequestedBy", fields: [requestedById], references: [id])

  @@unique([documentId, status])
  @@index([requestedById])
  @@index([approverId])
  @@index([status])
}

// Merges Notification and ErrNotification. eventKey (from ErrNotification) de-duplicates per user.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  documentId String?
  eventKey   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  user       User             @relation("NotificationsForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventKey, userId])
  @@index([userId, createdAt])
  @@index([isRead])
}

model EmailNotificationEvent {
  id          String         @id @default(cuid())
  recipientId String
  type        EmailEventType
  documentId  String?
  createdAt   DateTime       @default(now())
  emailDueAt  DateTime
  emailSent   Boolean        @default(false)
  claimedAt   DateTime?
  recipient   User           @relation("EmailEventsForUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([emailDueAt, emailSent, claimedAt])
  @@index([recipientId, emailDueAt])
  @@index([type, documentId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  documentId    String?
  performedById String
  action        String
  details       String?
  createdAt     DateTime @default(now())
  performedBy   User     @relation("AuditLogsPerformedBy", fields: [performedById], references: [id])

  @@index([documentId, createdAt])
  @@index([performedById, createdAt])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model OtpChallenge {
  id                 String    @id @default(cuid())
  userId             String
  challengeTokenHash String    @unique
  codeHash           String
  attempts           Int       @default(0)
  lockedUntil        DateTime?
  expiresAt          DateTime
  verifiedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

// ============================================================================
// ENUMS
// ============================================================================

// Pending-at-which-level is now currentWorkflowStep, not part of the status.
enum DocumentStatus {
  PENDING
  REVISION_REQUIRED
  ON_HOLD
  APPROVED
  CANCELLED
  ARCHIVED
}

enum StepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  REVISION
  ON_HOLD
}

enum ApproverType {
  USER
  USER_TYPE
}

enum ApprovalActionType {
  SUBMITTED
  APPROVED
  AUTO_APPROVED
  DELEGATED_APPROVED
  REJECTED
  REQUESTED_REVISION
  PUT_ON_HOLD
  RESUMED
  RESUBMITTED
  COMMENTED
  CANCELLED
  ARCHIVED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FieldGroup {
  HEADER
  LINE_ITEM
}

enum FieldDataType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum ProcessStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProcessStepSource {
  EXISTING
  UPLOADED
}

enum NotificationType {
  PENDING_APPROVAL
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_REVISED
  DOCUMENT_DELETED
  DOCUMENT_ON_HOLD
  DOCUMENT_RESUMED
}

enum EmailEventType {
  APPROVAL_PENDING
  WORKFLOW_APPROVED
  WORKFLOW_REJECTED
  APPROVAL_OVERDUE
  PROCESS_STEP_OVERDUE
}
