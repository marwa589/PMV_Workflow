generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                   @id @default(cuid())
  name                      String
  email                     String                   @unique
  passwordHash              String
  role                      UserRole
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  sessionVersion            Int                      @default(0)
  signatureFileSize         Int?
  signatureMimeType         String?
  signatureOriginalName     String?
  signaturePath             String?
  signatureUpdatedAt        DateTime?
  approvalHistory           ApprovalHistory[]        @relation("ApprovalsPerformedBy")
  auditLogsPerformed        AuditLog[]               @relation("AuditLogsPerformedBy")
  deletionRequestsReviewed  DeletionRequest[]        @relation("DeletionRequestsReviewedBy")
  deletionRequestsApproved  DeletionRequest[]        @relation("DeletionRequestsApprovedBy")
  deletionRequestsRequested DeletionRequest[]        @relation("DeletionRequestsRequestedBy")
  createdDocuments          Document[]               @relation("DocumentsCreatedBy")
  assignedDocuments         Document[]               @relation("CurrentApprover")
  uploadedVersions          DocumentVersion[]        @relation("VersionsUploadedBy")
  emailNotificationEvents   EmailNotificationEvent[] @relation("EmailEventsForUser")
  notifications             Notification[]           @relation("NotificationsForUser")
  otpChallenges             OtpChallenge[]
  trustedDevices            TrustedDevice[]
}

model Document {
  id                        String            @id @default(cuid())
  documentNumber            String            @unique
  title                     String
  description               String?
  status                    DocumentStatus
  currentVersion            Int               @default(1)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  createdById               String
  currentApproverId         String?
  documentType              DocumentType      @default(COMPARISON)
  mrType                    MrType?
  currentApproverAssignedAt DateTime?
  downloadedAt             DateTime?
  mrNumber                  String?
  relatedComparisonId       String?
  lastActiveStage           DocumentStatus?
  approvals                 ApprovalHistory[]
  deletionRequests          DeletionRequest[] @relation("DeletionRequests")
  createdBy                 User              @relation("DocumentsCreatedBy", fields: [createdById], references: [id])
  currentApprover           User?             @relation("CurrentApprover", fields: [currentApproverId], references: [id])
  relatedComparison         Document?         @relation("MRToComparison", fields: [relatedComparisonId], references: [id])
  linkedMRs                 Document[]        @relation("MRToComparison")
  versions                  DocumentVersion[]

  @@index([createdById])
  @@index([currentApproverId])
  @@index([relatedComparisonId])
  @@index([status])
}

model DocumentVersion {
  id             String            @id @default(cuid())
  documentId     String
  versionNumber  Int
  filePath       String
  originalName   String
  extension      String?
  mimeType       String
  fileSize       Int
  uploadedAt     DateTime          @default(now())
  uploadedById   String
  approvalEvents ApprovalHistory[]
  document       Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy     User              @relation("VersionsUploadedBy", fields: [uploadedById], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

model ApprovalHistory {
  id            String             @id @default(cuid())
  documentId    String
  action        ApprovalActionType
  comments      String?
  performedAt   DateTime           @default(now())
  performedById String
  versionId     String?
  document      Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  performedBy   User               @relation("ApprovalsPerformedBy", fields: [performedById], references: [id])
  version       DocumentVersion?   @relation(fields: [versionId], references: [id])

  @@index([documentId, performedAt])
  @@index([performedById])
  @@index([versionId])
}

model DeletionRequest {
  id              String                @id @default(cuid())
  documentId      String
  requestedById   String
  approver3Id     String?
  status          DeletionRequestStatus @default(PENDING)
  reason          String?
  createdAt       DateTime              @default(now())
  reviewedAt      DateTime?
  adminReviewerId String?
  adminReviewer   User?                 @relation("DeletionRequestsReviewedBy", fields: [adminReviewerId], references: [id])
  approver3       User?                 @relation("DeletionRequestsApprovedBy", fields: [approver3Id], references: [id])
  document        Document              @relation("DeletionRequests", fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy     User                  @relation("DeletionRequestsRequestedBy", fields: [requestedById], references: [id])

  @@unique([documentId, status])
  @@index([requestedById])
  @@index([approver3Id])
  @@index([status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  documentId String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  user       User             @relation("NotificationsForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([isRead])
}

model EmailNotificationEvent {
  id          String         @id @default(cuid())
  recipientId String
  type        EmailEventType
  documentId  String?
  createdAt   DateTime       @default(now())
  emailDueAt  DateTime
  emailSent   Boolean        @default(false)
  claimedAt   DateTime?
  recipient   User           @relation("EmailEventsForUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([emailDueAt, emailSent, claimedAt])
  @@index([recipientId, emailDueAt])
  @@index([type, documentId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  documentId    String?
  performedById String
  action        String
  details       String?
  createdAt     DateTime @default(now())
  performedBy   User     @relation("AuditLogsPerformedBy", fields: [performedById], references: [id])

  @@index([documentId, createdAt])
  @@index([performedById, createdAt])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model OtpChallenge {
  id                 String    @id @default(cuid())
  userId             String
  challengeTokenHash String    @unique
  codeHash           String
  attempts           Int       @default(0)
  lockedUntil        DateTime?
  expiresAt          DateTime
  verifiedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

enum UserRole {
  CLERK
  APPROVER_1
  APPROVER_2
  APPROVER_3
  ADMIN
}

enum DocumentStatus {
  PENDING_APPROVER_1
  PENDING_APPROVER_2
  PENDING_APPROVER_3
  APPROVED
  REJECTED
  REVISION_REQUIRED
  ARCHIVED
}

enum ApprovalActionType {
  SUBMITTED
  APPROVED
  REJECTED
  REQUESTED_REVISION
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  COMPARISON
  MATERIAL_REQUISITION
}

enum MrType {
  CASH
  CREDIT
}

enum NotificationType {
  PENDING_APPROVAL
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_REVISED
  DOCUMENT_DELETED
}

enum EmailEventType {
  APPROVAL_PENDING
  WORKFLOW_APPROVED
  WORKFLOW_REJECTED
  APPROVAL_OVERDUE
  COMPARISON_MR_OVERDUE
}
