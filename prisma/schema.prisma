generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ORGANISATION
// ============================================================================

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  companies         Company[]
  projects          Project[]
  scopedAssignments UserAssignment[]
}

model Company {
  id         String   @id @default(cuid())
  name       String
  locationId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  location          Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  scopedAssignments UserAssignment[]
  // Projects that belong to this company. A role given "for a company" covers all of them.
  projects          Project[]

  @@index([locationId])
}

// Replaces ErrProject and the free-text projectName columns.
model Project {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  locationId String?
  // The project director: picked from the users in Projects & Locations. A flow level set to "Project Director"
  // is sent to this person for documents of this project.
  directorId String?
  // The project manager, picked the same way. A flow level set to "Project Manager" is sent to this person.
  managerId  String?
  // Optional: the company this project belongs to. A role assignment scoped to that company covers the project.
  companyId  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location               Location?                       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  director               User?                           @relation("ProjectDirector", fields: [directorId], references: [id], onDelete: SetNull)
  manager                User?                           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  company                Company?                        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documents              Document[]
  flowAssignments        DocumentWorkflowAssignment[]
  scopedAssignments      UserAssignment[]
  assignmentScopes       UserAssignmentProjectScope[]
  counters               DocumentNumberCounter[]
  processInstances       ProcessInstance[]
  maintenanceTickets     MaintenanceTicket[]
  maintenanceAssignments MaintenanceWorkflowAssignment[]

  @@index([locationId, isActive])
  @@index([directorId])
  @@index([managerId])
  @@index([companyId])
}

// The four fixed kinds of user: Clerk, Engineer, Manager, Admin.
// Replaces the "type" half of the old UserRole enum. Never changes after account creation.
model UserType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  users                          User[]
  workflowStepApprovers          DocumentWorkflowStepApprover[]
  approvalStepApprovers          DocumentApprovalStepApprover[]
  maintenanceStepApprovers       MaintenanceWorkflowStepApprover[]
  maintenanceTicketStepApprovers MaintenanceTicketLevelApprover[]
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  userTypeId            String
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sessionVersion        Int       @default(0)
  signatureFileSize     Int?
  signatureMimeType     String?
  signatureOriginalName String?
  signaturePath         String?
  signatureUpdatedAt    DateTime?
  // When true, this user may select several pending documents and review/approve them together on one screen.
  canBulkApprove        Boolean   @default(false)
  // When true, workflow/ticket notification emails are not sent to this user. Sign-in and password-reset emails still are.
  emailNotificationsDisabled Boolean @default(false)

  userType                       UserType                          @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  assignments                     UserAssignment[]
  delegationsGiven                ApprovalDelegation[]              @relation("DelegationsGiven")
  delegationsReceived             ApprovalDelegation[]              @relation("DelegationsReceived")
  delegationsCreated              ApprovalDelegation[]              @relation("DelegationsCreatedBy")
  approvalHistory                 ApprovalHistory[]                 @relation("ApprovalsPerformedBy")
  approvalsOnBehalfOf             ApprovalHistory[]                 @relation("ApprovalsOnBehalfOf")
  auditLogsPerformed              AuditLog[]                        @relation("AuditLogsPerformedBy")
  deletionRequestsReviewed        DeletionRequest[]                 @relation("DeletionRequestsReviewedBy")
  deletionRequestsApproved        DeletionRequest[]                 @relation("DeletionRequestsApprovedBy")
  deletionRequestsRequested       DeletionRequest[]                 @relation("DeletionRequestsRequestedBy")
  createdDocuments                Document[]                        @relation("DocumentsCreatedBy")
  receivedDocuments               Document[]                        @relation("DocumentsReceivedBy")
  uploadedVersions                DocumentVersion[]                 @relation("VersionsUploadedBy")
  approvalStepsActed              DocumentApprovalStep[]            @relation("ApprovalStepActedBy")
  approvalStepsSent               DocumentApprovalStep[]            @relation("ApprovalStepSentBy")
  workflowStepApprovals           DocumentWorkflowStepApprover[]    @relation("WorkflowStepApprover")
  workflowTracks                  DocumentWorkflowTrack[]           @relation("WorkflowTrackReceiver")
  approvalTracks                  DocumentApprovalTrack[]           @relation("ApprovalTrackReceiver")
  approvalStepApprovals           DocumentApprovalStepApprover[]    @relation("ApprovalStepApprover")
  emailNotificationEvents         EmailNotificationEvent[]          @relation("EmailEventsForUser")
  emailDigestState                EmailDigestState?
  mailSettings                    MailSetting[]
  mailFollowRules                 MailFollowRule[]
  notifications                   Notification[]                    @relation("NotificationsForUser")
  otpChallenges                   OtpChallenge[]
  trustedDevices                  TrustedDevice[]
  passwordResetTokens             PasswordResetToken[]
  processInstancesStarted         ProcessInstance[]                 @relation("ProcessInstancesStartedBy")
  maintenanceTicketsCreated       MaintenanceTicket[]               @relation("MaintenanceTicketRequester")
  maintenanceLevelActions         MaintenanceTicketEvent[]          @relation("MaintenanceEventActor")
  maintenanceStepApprovals        MaintenanceWorkflowStepApprover[] @relation("MaintenanceStepUser")
  maintenanceAttachments          MaintenanceTicketAttachment[]     @relation("MaintenanceAttachmentUploader")
  maintenanceTicketLevelsActed    MaintenanceTicketLevel[]          @relation("MaintenanceLevelActedBy")
  maintenanceTicketLevelApprovals MaintenanceTicketLevelApprover[]
  processStepLinks                ProcessStepDocument[]             @relation("ProcessStepLinkedBy")
  documentDownloads               DocumentDownload[]
  directedProjects                Project[]                         @relation("ProjectDirector")
  managedProjects                 Project[]                         @relation("ProjectManager")

  @@index([userTypeId, isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// DOCUMENT CONFIGURATION
// ============================================================================

// Replaces enum DocumentType, enum ErrType, enum ErrFileKind and PurchaseOrder.
model DocumentType {
  id                          String   @id @default(cuid())
  code                        String   @unique
  numberingCode               String   @unique @default("")
  name                        String   @unique
  description                 String?
  namingPattern               String   @default("{TYPE}-{PROJECT}-{YYYY}-{SEQ:4}")
  supportsLineItems           Boolean  @default(false)
  receiptConfirmationRequired Boolean  @default(true)
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())

  subtypes          DocumentSubtype[]
  fieldDefinitions  FieldDefinition[]
  counters          DocumentNumberCounter[]
  documents         Document[]
  flowAssignments   DocumentWorkflowAssignment[]
  processSteps      ProcessStep[]
  referenceForSteps ProcessStep[]                     @relation("ProcessStepReferenceType")
  scopedAssignments UserAssignment[]
  assignmentScopes  UserAssignmentDocumentTypeScope[]
  mailFollowRules   MailFollowRule[]
}

// Replaces Document.documentSubtype, enum MrType, enum ComparisonType and the ERR type variants.
model DocumentSubtype {
  id                          String   @id @default(cuid())
  documentTypeId              String
  code                        String
  numberingCode               String   @default("")
  name                        String
  receiptConfirmationRequired Boolean?
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())

  documentType      DocumentType                         @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  fieldDefinitions  FieldDefinition[]
  documents         Document[]
  flowAssignments   DocumentWorkflowAssignment[]
  processSteps      ProcessStep[]
  referenceForSteps ProcessStep[]                        @relation("ProcessStepReferenceSubtype")
  scopedAssignments UserAssignment[]
  assignmentScopes  UserAssignmentDocumentSubtypeScope[]
  counters          DocumentNumberCounter[]

  @@unique([documentTypeId, code])
  @@unique([documentTypeId, numberingCode])
  @@unique([documentTypeId, name])
}

model FieldDefinition {
  id                String        @id @default(cuid())
  documentTypeId    String
  documentSubtypeId String?
  fieldGroup        FieldGroup    @default(HEADER)
  fieldKey          String
  label             String
  dataType          FieldDataType
  isRequired        Boolean       @default(false)
  options           Json?
  sortOrder         Int           @default(0)
  isActive          Boolean       @default(true)

  documentType    DocumentType         @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype DocumentSubtype?     @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  values          DocumentFieldValue[]

  @@unique([documentTypeId, documentSubtypeId, fieldGroup, fieldKey])
  @@index([documentTypeId, documentSubtypeId, isActive])
}

// Running counter behind document numbers. Subtyped document numbers use type + sub type + year;
// documents without a subtype retain the type + project + year scope.
model DocumentNumberCounter {
  id                String  @id @default(cuid())
  documentTypeId    String
  documentSubtypeId String?
  projectId         String?
  periodYear        Int
  lastValue         Int     @default(0)

  documentType    DocumentType     @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype DocumentSubtype? @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([documentTypeId, documentSubtypeId, projectId, periodYear])
}

// ============================================================================
// ROLES, PERMISSIONS AND ACCESS
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  assignments UserAssignment[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// This user holds this role, limited by its optional legacy single scopes and new multi-value scope relations.
// Empty scope values mean no restriction on that item.
// Replaces UserRoleAssignment and ErrUserAccess.
model UserAssignment {
  id                  String   @id @default(cuid())
  userId              String
  roleId              String
  companyId           String?
  projectId           String?
  locationId          String?
  documentTypeId      String?
  documentSubtypeId   String?
  createdAt           DateTime @default(now())

  user               User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               Role                              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company            Company?                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            Project?                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location           Location?                         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  documentType       DocumentType?                     @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype    DocumentSubtype?                  @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  projectScopes      UserAssignmentProjectScope[]
  documentTypeScopes UserAssignmentDocumentTypeScope[]

  @@unique([userId, roleId, companyId, projectId, locationId, documentTypeId, documentSubtypeId], map: "UserAssignment_userId_roleId_companyId_projectId_locationId_key")
  @@index([userId])
  @@index([roleId])
  @@index([projectId])
}

model UserAssignmentProjectScope {
  userAssignmentId String
  projectId        String

  assignment UserAssignment @relation(fields: [userAssignmentId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userAssignmentId, projectId])
  @@index([projectId])
}

model UserAssignmentDocumentTypeScope {
  userAssignmentId String
  documentTypeId   String
  allSubtypes      Boolean @default(true)

  assignment   UserAssignment                       @relation(fields: [userAssignmentId], references: [id], onDelete: Cascade)
  documentType DocumentType                         @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  subtypes     UserAssignmentDocumentSubtypeScope[]

  @@id([userAssignmentId, documentTypeId])
  @@index([documentTypeId])
}

model UserAssignmentDocumentSubtypeScope {
  userAssignmentId  String
  documentTypeId    String
  documentSubtypeId String

  documentTypeScope UserAssignmentDocumentTypeScope @relation(fields: [userAssignmentId, documentTypeId], references: [userAssignmentId, documentTypeId], onDelete: Cascade)
  documentSubtype   DocumentSubtype                 @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)

  @@id([userAssignmentId, documentTypeId, documentSubtypeId])
  @@index([documentSubtypeId])
}

// An admin hands one user's approval tasks to another user, optionally until a fixed expiry time.
model ApprovalDelegation {
  id              String    @id @default(cuid())
  delegatorUserId String
  delegateUserId  String
  createdById     String
  reason          String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  delegator User @relation("DelegationsGiven", fields: [delegatorUserId], references: [id], onDelete: Cascade)
  delegate  User @relation("DelegationsReceived", fields: [delegateUserId], references: [id], onDelete: Cascade)
  createdBy User @relation("DelegationsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([delegatorUserId, delegateUserId])
  @@index([delegateUserId])
}

// ============================================================================
// APPROVAL FLOWS
// ============================================================================

// A named approval chain. Keeps the old model name; targeting moved to DocumentWorkflowAssignment.
model DocumentWorkflowTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       DocumentWorkflowStep[]
  assignments DocumentWorkflowAssignment[]
  documents   Document[]
}

// stepNumber 0 = uploader step; 1 to 10 = approval levels.
model DocumentWorkflowStep {
  id                String   @id @default(cuid())
  templateId        String
  stepNumber        Int
  name              String?
  // Whether the approver must place a signature to approve at this level (on by default).
  signatureRequired Boolean  @default(true)
  createdAt         DateTime @default(now())

  template  DocumentWorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvers DocumentWorkflowStepApprover[]
  tracks    DocumentWorkflowTrack[]

  @@unique([templateId, stepNumber])
}

// A unique track offered at a level (the uploader level included): whoever acts at that level can tick it, and the
// document then goes straight to `receiver`. When the receiver approves it goes to `returnLevel`, or counts as fully
// approved when returnLevel is null.
model DocumentWorkflowTrack {
  id                String   @id @default(cuid())
  stepId            String
  name              String
  receiverUserId    String
  returnLevel       Int?
  // Whether the receiver must place a signature to approve.
  signatureRequired Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  step     DocumentWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  receiver User                 @relation("WorkflowTrackReceiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([receiverUserId])
}

// Who may act on a level (any one entry is enough): a named user OR every user of a user type.
model DocumentWorkflowStepApprover {
  id           String       @id @default(cuid())
  stepId       String
  approverType ApproverType
  userTypeId   String?
  userId       String?

  step     DocumentWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userType UserType?            @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  user     User?                @relation("WorkflowStepApprover", fields: [userId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([userId])
  @@index([userTypeId])
}

// Decides which flow a document gets. Most specific row wins. Null templateId = auto-approve.
model DocumentWorkflowAssignment {
  id                String   @id @default(cuid())
  documentTypeId    String
  documentSubtypeId String?
  projectId         String?
  templateId        String?
  createdAt         DateTime @default(now())

  documentType    DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  documentSubtype DocumentSubtype?          @relation(fields: [documentSubtypeId], references: [id], onDelete: Cascade)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        DocumentWorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([documentTypeId, documentSubtypeId, projectId])
  @@index([templateId])
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id                        String          @id @default(cuid())
  documentNumber            String          @unique
  submissionKey             String?         @unique
  title                     String
  description               String?
  status                    DocumentStatus  @default(PENDING)
  currentVersion            Int             @default(1)
  revisionNumber            Int             @default(1)
  lockVersion               Int             @default(0)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  approvedAt                DateTime?
  createdById               String
  documentTypeId            String
  documentSubtypeId         String?
  projectId                 String?
  workflowTemplateId        String?
  currentWorkflowStep       Int?
  currentApproverAssignedAt DateTime?
  downloadedAt              DateTime?
  lastActiveStage           DocumentStatus?
  receivedAt                DateTime?
  // A reference document: uploaded next to a process step's document, never approved, and visible only to people
  // holding documents.view_reference (hidden from every list, search and download for everyone else).
  isReference               Boolean         @default(false)
  receivedById              String?

  createdBy        User                      @relation("DocumentsCreatedBy", fields: [createdById], references: [id])
  receivedBy       User?                     @relation("DocumentsReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  documentType     DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  documentSubtype  DocumentSubtype?          @relation(fields: [documentSubtypeId], references: [id], onDelete: Restrict)
  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workflowTemplate DocumentWorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]
  approvals        ApprovalHistory[]
  approvalSteps    DocumentApprovalStep[]
  lineItems        DocumentLineItem[]
  fieldValues      DocumentFieldValue[]
  deletionRequests DeletionRequest[]         @relation("DeletionRequests")
  processLinks     ProcessStepDocument[]
  referencedBy     ProcessStepReference[]    @relation("ProcessStepReference")
  followUpRuns     ProcessInstance[]         @relation("ProcessFollowedDocument")
  downloadRecords  DocumentDownload[]

  @@index([createdById])
  @@index([workflowTemplateId])
  @@index([documentTypeId, documentSubtypeId])
  @@index([projectId, status])
  @@index([status, currentWorkflowStep])
  @@index([createdAt])
  @@index([receivedById])
}

// One row per user per document: when that user last downloaded the approved document.
// (Document.downloadedAt is the old, shared flag. It is no longer read or written.)
model DocumentDownload {
  id           String   @id @default(cuid())
  documentId   String
  userId       String
  downloadedAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId, downloadedAt])
}

model DocumentLineItem {
  id         String @id @default(cuid())
  documentId String
  lineNo     Int

  document    Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldValues DocumentFieldValue[]

  @@unique([documentId, lineNo])
}

model DocumentFieldValue {
  id                String    @id @default(cuid())
  documentId        String
  fieldDefinitionId String
  lineItemId        String?
  valueText         String?
  valueNumber       Decimal?
  valueDate         DateTime? @db.Date
  valueBoolean      Boolean?
  valueJson         Json?

  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition   @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  lineItem        DocumentLineItem? @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@unique([documentId, fieldDefinitionId, lineItemId])
  @@index([fieldDefinitionId])
}

// Uploaded file versions. Keeps the old model and column names.
model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  versionNumber  Int
  revisionNumber Int      @default(1)
  filePath       String
  storageFolder  String?
  originalName   String
  extension      String?
  mimeType       String
  fileSize       Int
  uploadedAt     DateTime @default(now())
  uploadedById   String

  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User              @relation("VersionsUploadedBy", fields: [uploadedById], references: [id])
  approvalEvents  ApprovalHistory[] @relation("ApprovalInputVersion")
  approvalOutputs ApprovalHistory[] @relation("ApprovalOutputVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

// ============================================================================
// PROCESSES
// ============================================================================

model ProcessDefinition {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  isActive       Boolean  @default(true)
  // Editing a process that already has runs creates a new version of its tree: runs keep the version they
  // started with, new uploads use currentVersion.
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())

  steps             ProcessStep[]
  instances         ProcessInstance[]
}

// One node of a process tree. parentStepId = null marks the root (the document whose upload starts a run);
// every other node hangs under exactly one parent. A node's children are the optional "next document" choices:
// whichever child gets uploaded decides the path the run follows. A node with no children ends the path.
// stepNumber is only a unique label for the node inside its process (1 = root, then depth-first order).
model ProcessStep {
  id                         String  @id @default(cuid())
  processDefinitionId        String
  stepNumber                 Int
  name                       String
  documentTypeId             String
  documentSubtypeId          String?
  parentStepId               String?
  versionNumber              Int     @default(1)
  // Optional reference document the uploader of this step may attach (a type, or a sub type of it).
  referenceDocumentTypeId    String?
  referenceDocumentSubtypeId String?
  // Hours to wait after the PARENT document is finally approved before this step may be uploaded (0 = no wait).
  delayHours                 Int     @default(0)
  // "Allow multiple uploads" (set up per step, off by default): several documents may be uploaded together for this
  // step; each one starts its own follow-up run, linked to the run and the approved document it follows.
  allowMultipleUploads       Boolean @default(false)

  processDefinition        ProcessDefinition     @relation(fields: [processDefinitionId], references: [id], onDelete: Cascade)
  documentType             DocumentType          @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  documentSubtype          DocumentSubtype?      @relation(fields: [documentSubtypeId], references: [id], onDelete: Restrict)
  referenceDocumentType    DocumentType?         @relation("ProcessStepReferenceType", fields: [referenceDocumentTypeId], references: [id], onDelete: Restrict)
  referenceDocumentSubtype DocumentSubtype?      @relation("ProcessStepReferenceSubtype", fields: [referenceDocumentSubtypeId], references: [id], onDelete: Restrict)
  parentStep               ProcessStep?          @relation("ProcessStepTree", fields: [parentStepId], references: [id], onDelete: Cascade)
  childSteps               ProcessStep[]         @relation("ProcessStepTree")
  stepDocuments            ProcessStepDocument[]
  runsAtStep               ProcessInstance[]     @relation("ProcessInstanceCurrentStep")

  @@unique([processDefinitionId, versionNumber, stepNumber])
  @@index([parentStepId])
}

model ProcessInstance {
  id                  String        @id @default(cuid())
  processDefinitionId String
  projectId           String?
  reference           String?
  status              ProcessStatus @default(IN_PROGRESS)
  currentStepNumber   Int           @default(1)
  // The last node whose document was approved (null until the root document is approved). While the run is
  // in progress, its child nodes are the choices for the next upload.
  currentStepId       String?
  // Which version of the process tree this run follows (fixed when the run starts).
  stepVersion         Int           @default(1)
  startedById         String
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  // Follow-up runs ("allow multiple uploads"): when several documents are uploaded together as the next step of a
  // run, each one becomes its own run. It points back at the run it follows and at the approved document it follows
  // (e.g. a comparison sheet followed by six MRs = six runs, all linked to that sheet). Null for ordinary runs.
  parentInstanceId    String?
  followedDocumentId  String?

  processDefinition ProcessDefinition     @relation(fields: [processDefinitionId], references: [id], onDelete: Restrict)
  parentInstance    ProcessInstance?      @relation("ProcessFollowUps", fields: [parentInstanceId], references: [id], onDelete: SetNull)
  followUps         ProcessInstance[]     @relation("ProcessFollowUps")
  followedDocument  Document?             @relation("ProcessFollowedDocument", fields: [followedDocumentId], references: [id], onDelete: SetNull)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  startedBy         User                  @relation("ProcessInstancesStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  currentStep       ProcessStep?          @relation("ProcessInstanceCurrentStep", fields: [currentStepId], references: [id], onDelete: SetNull)
  stepDocuments     ProcessStepDocument[]
  uploadNotices     ProcessUploadNotice[]

  @@index([processDefinitionId, status])
  @@index([currentStepId])
  @@index([projectId])
  @@index([parentInstanceId])
  @@index([followedDocumentId])
}

// The document that filled a node of a run; rejected ones stay as history (isCurrent = false).
// "Only one current document per node per run" is enforced by a partial unique index in the migration.
model ProcessStepDocument {
  id                  String            @id @default(cuid())
  processInstanceId   String
  processStepId       String
  documentId          String
  source              ProcessStepSource
  linkedById          String
  isCurrent           Boolean           @default(true)
  linkedAt            DateTime          @default(now())
  isAddition          Boolean           @default(false)

  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)
  processStep       ProcessStep     @relation(fields: [processStepId], references: [id], onDelete: Restrict)
  document          Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  // Any number of reference documents uploaded (or picked from approved documents) together with this step's document.
  references        ProcessStepReference[]
  linkedBy          User            @relation("ProcessStepLinkedBy", fields: [linkedById], references: [id], onDelete: Restrict)

  @@unique([processInstanceId, processStepId, documentId])
  @@index([documentId])
}

// One reference document attached to a step's document. Reference documents are not part of the run's flow: they are
// never approved and only shown to people holding documents.view_reference. A step document can have any number.
model ProcessStepReference {
  id                    String   @id @default(cuid())
  processStepDocumentId String
  documentId            String
  createdAt             DateTime @default(now())

  processStepDocument ProcessStepDocument @relation(fields: [processStepDocumentId], references: [id], onDelete: Cascade)
  document            Document            @relation("ProcessStepReference", fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([processStepDocumentId, documentId])
  @@index([documentId])
}

// Remembers that people were told a delayed (or immediate) next step of a run has opened for upload,
// so the scheduled job never tells them twice for the same approved document.
model ProcessUploadNotice {
  id                String   @id @default(cuid())
  processInstanceId String
  processStepId     String
  anchorDocumentId  String
  notifiedAt        DateTime @default(now())

  processInstance ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)

  @@unique([processInstanceId, processStepId, anchorDocumentId])
}

// ============================================================================
// APPROVAL EXECUTION
// ============================================================================

// Copy of the flow's levels, made at upload. Later flow edits never change documents in progress.
model DocumentApprovalStep {
  id                String     @id @default(cuid())
  documentId        String
  levelNumber       Int
  name              String?
  // Copied from the flow when the document is uploaded.
  signatureRequired Boolean    @default(true)
  status            StepStatus @default(WAITING)
  actedById         String?
  actedAt           DateTime?
  comment           String?
  // A step created when a document is sent down a unique track (levelNumber is 1000 + origin level * 100 + the track's
  // position, so it never clashes with the flow's own levels). originLevel is the level the track was taken at;
  // returnLevel is where the document goes once the receiver approves (null = fully approved).
  isTrackStep       Boolean    @default(false)
  originLevel       Int?
  returnLevel       Int?
  // A step created by "Send for approval": the person at `originLevel` picked one user to approve first (levelNumber
  // is 1,000,000 + a counter). When that user approves, the document goes back to originLevel and to `sentById`.
  isSideApproval    Boolean    @default(false)
  sentById          String?
  // The flow sends this level to the Project Director / Manager, but the project had none when the document was
  // uploaded. The level waits ("Pending Project Director - No PD Assigned") until one is set on the project (the
  // person is then added here) or an Admin user sends the level to someone.
  awaitingProjectDirector Boolean @default(false)
  awaitingProjectManager  Boolean @default(false)

  document  Document                       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actedBy   User?                          @relation("ApprovalStepActedBy", fields: [actedById], references: [id], onDelete: SetNull)
  sentBy    User?                          @relation("ApprovalStepSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  approvers DocumentApprovalStepApprover[]
  tracks    DocumentApprovalTrack[]

  @@unique([documentId, levelNumber])
  @@index([sentById])
}

// The unique tracks of a level, copied from the flow when the document is uploaded (later flow edits never change it).
model DocumentApprovalTrack {
  id                String   @id @default(cuid())
  stepId            String
  name              String
  receiverUserId    String
  returnLevel       Int?
  signatureRequired Boolean  @default(true)
  sortOrder         Int      @default(0)

  step     DocumentApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  receiver User                 @relation("ApprovalTrackReceiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([receiverUserId])
}

model DocumentApprovalStepApprover {
  id           String       @id @default(cuid())
  stepId       String
  approverType ApproverType
  userTypeId   String?
  userId       String?
  // True when this entry came from a "Project Director" flow entry. If the project's director changes, levels
  // that have not been acted on yet move to the new director.
  viaProjectDirector Boolean @default(false)
  // The same for a "Project Manager" flow entry.
  viaProjectManager  Boolean @default(false)

  step     DocumentApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userType UserType?            @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  user     User?                @relation("ApprovalStepApprover", fields: [userId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([userId])
  @@index([userTypeId])
}

// Permanent history (the PDF's document_activity_log). Replaces ApprovalHistory + ErrApprovalHistory.
model ApprovalHistory {
  id                  String             @id @default(cuid())
  documentId          String
  action              ApprovalActionType
  comments            String?
  performedAt         DateTime           @default(now())
  performedById       String
  versionId           String?
  outputVersionId     String?
  revisionNumber      Int                @default(1)
  levelNumber         Int?
  fromStatus          DocumentStatus?
  toStatus            DocumentStatus?
  revisionTargetLevel Int?
  onBehalfOfUserId    String?

  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  performedBy   User             @relation("ApprovalsPerformedBy", fields: [performedById], references: [id])
  onBehalfOf    User?            @relation("ApprovalsOnBehalfOf", fields: [onBehalfOfUserId], references: [id])
  version       DocumentVersion? @relation("ApprovalInputVersion", fields: [versionId], references: [id])
  outputVersion DocumentVersion? @relation("ApprovalOutputVersion", fields: [outputVersionId], references: [id])

  @@index([documentId, performedAt])
  @@index([performedById])
  @@index([versionId])
  @@index([outputVersionId])
}

// ============================================================================
// CARRIED OVER FROM THE CURRENT SYSTEM (not in the PDF)
// ============================================================================

// approver3Id is now approverId: the reviewer is anyone holding the deletion-review permission.
model DeletionRequest {
  id              String                @id @default(cuid())
  documentId      String
  requestedById   String
  approverId      String?
  status          DeletionRequestStatus @default(PENDING)
  reason          String?
  createdAt       DateTime              @default(now())
  reviewedAt      DateTime?
  adminReviewerId String?
  adminReviewer   User?                 @relation("DeletionRequestsReviewedBy", fields: [adminReviewerId], references: [id])
  approver        User?                 @relation("DeletionRequestsApprovedBy", fields: [approverId], references: [id])
  document        Document              @relation("DeletionRequests", fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy     User                  @relation("DeletionRequestsRequestedBy", fields: [requestedById], references: [id])

  @@unique([documentId, status])
  @@index([requestedById])
  @@index([approverId])
  @@index([status])
}

// Merges Notification and ErrNotification. eventKey (from ErrNotification) de-duplicates per user.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  documentId String?
  eventKey   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  user       User             @relation("NotificationsForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventKey, userId])
  @@index([userId, createdAt])
  @@index([isRead])
}

// One row per person: when their last "pending tasks" email went out. The hourly digest claims the row atomically
// (claimedAt) before sending, so two workers (or the cron endpoint) can never send the same person two emails.
model EmailDigestState {
  userId     String    @id
  lastSentAt DateTime  @default(now())
  claimedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row (id "global"): hours between two summary emails to the same person. No row = every 1 hour.
model MailDigestConfig {
  id            String   @id @default("global")
  intervalHours Int      @default(1)
  updatedAt     DateTime @updatedAt
}

// What kinds of email people get. The mailing list is managed on its own page and no longer depends on roles.
// MailKindDefault: how each kind is delivered unless a person has their own setting.
model MailKindDefault {
  kind     MailKind     @id
  delivery MailDelivery
}

// One person's setting for one kind of email. delivery null = follow the default for that kind.
// The three lists limit the documents the person is emailed about; empty lists mean everything they may access.
// A document type id covers all its sub types; a sub type id covers only that sub type.
// For the WATCH_* kinds a row is what puts the person on the list at all; for the other kinds the person is
// emailed because of their involvement (approver, uploader, creator) and the row only adjusts delivery and scope.
model MailSetting {
  id                 String        @id @default(cuid())
  userId             String
  kind               MailKind
  delivery           MailDelivery?
  projectIds         String[]
  documentTypeIds    String[]
  documentSubtypeIds String[]
  updatedAt          DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([kind])
}

// "Email me when a document of this TYPE is uploaded / approved in the same process run as a document I uploaded
// (scope OWN_UPLOADS) or can open (scope ACCESSIBLE)". One rule per person, scope and document type; set by an admin.
model MailFollowRule {
  id             String          @id @default(cuid())
  userId         String
  scope          MailFollowScope
  documentTypeId String
  events         MailFollowEvent[]
  delivery       MailDelivery?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, documentTypeId])
  @@index([documentTypeId])
}

model EmailNotificationEvent {
  id          String         @id @default(cuid())
  recipientId String
  type        EmailEventType
  documentId  String?
  // Which mailing-list kind this event belongs to (null for events queued before kinds existed) and whether it is
  // sent on its own (INSTANT delivery) instead of inside the hourly summary.
  kind        MailKind?
  instant     Boolean        @default(false)
  // Failed sends of an instant email. It is retried a little later each time and dropped after a few tries, so one
  // address that keeps failing never holds up everybody else's emails.
  attempts    Int            @default(0)
  createdAt   DateTime       @default(now())
  emailDueAt  DateTime
  emailSent   Boolean        @default(false)
  claimedAt   DateTime?
  recipient   User           @relation("EmailEventsForUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([emailDueAt, emailSent, claimedAt])
  @@index([recipientId, emailDueAt])
  @@index([type, documentId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  documentId    String?
  performedById String
  action        String
  details       String?
  createdAt     DateTime @default(now())
  performedBy   User     @relation("AuditLogsPerformedBy", fields: [performedById], references: [id])

  @@index([documentId, createdAt])
  @@index([performedById, createdAt])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model OtpChallenge {
  id                 String    @id @default(cuid())
  userId             String
  challengeTokenHash String    @unique
  codeHash           String
  attempts           Int       @default(0)
  lockedUntil        DateTime?
  expiresAt          DateTime
  verifiedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

// ============================================================================
// ENUMS
// ============================================================================

// ============================================================================
// MAINTENANCE MANAGEMENT
// ============================================================================

model MaintenanceItem {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MaintenanceWorkflowAssignment[]
  tickets     MaintenanceTicket[]
}

model MaintenanceWorkflow {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels      MaintenanceWorkflowLevel[]
  assignments MaintenanceWorkflowAssignment[]
  tickets     MaintenanceTicket[]
}

model MaintenanceWorkflowLevel {
  id          String   @id @default(cuid())
  workflowId  String
  levelNumber Int
  name        String
  createdAt   DateTime @default(now())

  workflow  MaintenanceWorkflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approvers MaintenanceWorkflowStepApprover[]

  @@unique([workflowId, levelNumber])
  @@index([workflowId, levelNumber])
}

model MaintenanceWorkflowStepApprover {
  id           String       @id @default(cuid())
  levelId      String
  approverType ApproverType
  userId       String?
  userTypeId   String?

  level    MaintenanceWorkflowLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  user     User?                    @relation("MaintenanceStepUser", fields: [userId], references: [id], onDelete: Cascade)
  userType UserType?                @relation(fields: [userTypeId], references: [id], onDelete: Restrict)

  @@index([levelId])
  @@index([userId])
  @@index([userTypeId])
}

model MaintenanceWorkflowAssignment {
  id         String   @id @default(cuid())
  projectId  String
  itemId     String
  workflowId String
  createdAt  DateTime @default(now())

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item     MaintenanceItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  workflow MaintenanceWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@unique([projectId, itemId])
  @@index([workflowId])
}

model MaintenanceTicket {
  id           String                  @id @default(cuid())
  ticketNumber String                  @unique
  projectId    String
  itemId       String
  requesterId  String
  workflowId   String
  requestType  MaintenanceRequestType
  units        Int
  phoneNumber  String
  description  String
  status       MaintenanceTicketStatus @default(OPEN)
  currentLevel Int                     @default(1)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  closedAt     DateTime?

  project     Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  item        MaintenanceItem               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requester   User                          @relation("MaintenanceTicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  workflow    MaintenanceWorkflow           @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  events      MaintenanceTicketEvent[]
  attachments MaintenanceTicketAttachment[]
  steps       MaintenanceTicketLevel[]

  @@index([requesterId, createdAt])
  @@index([projectId, status])
  @@index([status, currentLevel])
}

model MaintenanceTicketLevel {
  id          String    @id @default(cuid())
  ticketId    String
  levelNumber Int
  name        String
  status      String    @default("PENDING")
  actedById   String?
  actedAt     DateTime?

  ticket    MaintenanceTicket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actedBy   User?                            @relation("MaintenanceLevelActedBy", fields: [actedById], references: [id], onDelete: SetNull)
  approvers MaintenanceTicketLevelApprover[]

  @@unique([ticketId, levelNumber])
}

model MaintenanceTicketLevelApprover {
  id           String       @id @default(cuid())
  levelId      String
  approverType ApproverType
  userId       String?
  userTypeId   String?

  level    MaintenanceTicketLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  user     User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  userType UserType?              @relation(fields: [userTypeId], references: [id], onDelete: Restrict)

  @@index([levelId])
  @@index([userId])
  @@index([userTypeId])
}

model MaintenanceTicketEvent {
  id          String   @id @default(cuid())
  ticketId    String
  actorId     String
  levelNumber Int?
  action      String
  details     String?
  createdAt   DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User              @relation("MaintenanceEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model MaintenanceTicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  uploadedById String
  filePath     String
  originalName String
  mimeType     String
  fileSize     Int
  createdAt    DateTime @default(now())

  ticket     MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation("MaintenanceAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

enum MaintenanceRequestType {
  REPAIR
  NEW_INSTALLATION
}

enum MaintenanceTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Pending-at-which-level is now currentWorkflowStep, not part of the status.
enum DocumentStatus {
  PENDING
  REVISION_REQUIRED
  ON_HOLD
  APPROVED
  CANCELLED
  ARCHIVED
}

enum StepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  REVISION
  ON_HOLD
  // Bypassed on purpose: the document took a unique track that returns past this level.
  SKIPPED
}

enum ApproverType {
  USER
  USER_TYPE
  // Flow templates only: the director of the document's project. When a document starts its flow this is
  // copied onto the document as a USER entry (viaProjectDirector = true) naming the director at that time.
  PROJECT_DIRECTOR
  // Flow templates only: the manager of the document's project, copied the same way (viaProjectManager = true).
  PROJECT_MANAGER
}

enum ApprovalActionType {
  SUBMITTED
  APPROVED
  AUTO_APPROVED
  DELEGATED_APPROVED
  REJECTED
  REQUESTED_REVISION
  PUT_ON_HOLD
  RESUMED
  RESUBMITTED
  COMMENTED
  CANCELLED
  ARCHIVED
  // The document was sent down a unique track (straight to a named person) from a level.
  UNIQUE_TRACK
  // Someone sent the document to a chosen person for approval; it comes back to them once that person approves.
  SENT_FOR_APPROVAL
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FieldGroup {
  HEADER
  LINE_ITEM
}

enum FieldDataType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum ProcessStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProcessStepSource {
  EXISTING
  UPLOADED
}

enum NotificationType {
  PENDING_APPROVAL
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_REVISED
  DOCUMENT_DELETED
  DOCUMENT_ON_HOLD
  DOCUMENT_RESUMED
  PROCESS_UPLOAD_READY
  // A deletion request waits for the people who may review it.
  DELETION_REQUESTED
}

enum EmailEventType {
  APPROVAL_PENDING
  WORKFLOW_APPROVED
  WORKFLOW_REJECTED
  WORKFLOW_REVISION_REQUESTED
  APPROVAL_OVERDUE
  PROCESS_STEP_OVERDUE
  PROCESS_UPLOAD_READY
  PROCESS_DOCUMENT_UPLOADED
}

enum MailKind {
  AWAITING_REVIEW
  AWAITING_UPLOAD
  OWN_APPROVED
  OWN_REJECTED
  OWN_REVISION
  WATCH_APPROVED
  WATCH_REJECTED
  WATCH_REVISION
  PROCESS_UPLOADED
  PROCESS_APPROVED
}

// Which documents of a process a follow-up rule looks at: the ones the person uploaded, or the ones they may open.
enum MailFollowScope {
  OWN_UPLOADS
  ACCESSIBLE
}

enum MailFollowEvent {
  UPLOADED
  APPROVED
}

enum MailDelivery {
  OFF
  DIGEST
  INSTANT
}
